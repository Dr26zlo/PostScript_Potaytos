  m_Script: {fileID: 11500000, guid: 98251286619e7e2449f1f359deb3b322, type: 3}
  m_Name: "\u0424\u043E\u043D\u0430\u0440\u0449\u0438\u043A_4"
  m_EditorClassIdentifier: 
  speakerName: "\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0444\u043E\u043D\u0430\u0440\u0449\u0438\u043A"
  dialogueText: "\u0422\u043E\u043B\u044C\u043A\u043E... \u043F\u0440\u043E\u0448\u0443
    \u0432\u0430\u0441. \u041D\u0435 \u043F\u0438\u0448\u0438\u0442\u0435 \u0442\u0430\u043C
    \u043F\u0440\u043E \u0435\u0433\u043E \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E.
    \u0427\u0442\u043E \u043E\u043D... \u043D\u0443, \u0437\u0432\u0435\u043D\u0438\u0442,
    \u0435\u0441\u043B\u0438 \r\n\u043D\u0435\u043F\u0440\u0430\u0432\u0434\u0443
    \u0433\u043E\u0432\u043E\u0440\u044F\u0442."
  choices:
  - choiceText: "\u041F\u0440\u0438\u043D\u044F\u0442\u043E. \u041E\u043F\u0438\u0448\u0438\u0442\u0435
      \u043F\u0440\u0438\u043C\u0435\u0442\u044B \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u0430
      \u0438 \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u043E\u043F\u0430\u0436\u0438."
    nextNode: {fileID: 11400000, guid: 5915e5f672a5d094294662bc0465b09d, type: 2}
    choiceID: F_REPLY_1
  - choiceText: "\u041F\u043E\u043D\u0438\u043C\u0430\u044E, \u0431\u0435\u0437 \u0441\u0438\u0433\u043D\u0430\u043B\u0430
      \u0442\u0435\u043C\u043D\u043E. \u041A\u043E\u0433\u0434\u0430 \u0432\u044B
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0435\u0433\u043E \u0432  \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437?"
    nextNode: {fileID: 11400000, guid: 5915e5f672a5d094294662bc0465b09d, type: 2}
    choiceID: F_REPLY_2
  - choiceText: "\u0421\u043B\u0443\u0448\u0430\u044E. \u0414\u0438\u043A\u0442\u0443\u0439\u0442\u0435
      \u0442\u0435\u043A\u0441\u0442."
    nextNode: {fileID: 11400000, guid: 5915e5f672a5d094294662bc0465b09d, type: 2}
    choiceID: F_REPLY_3
  nextNode: {fileID: 0}
